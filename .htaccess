# ---------------------------------------------------------------------------
# Arail Pharmaceuticals - web server rules
#
# KEEP THIS FILE SMALL. It is read by Apache *and* by phpix, the PHP runtime
# Wasmer Edge uses for this app. phpix parses .htaccess itself and implements
# only a small subset: the moment it meets a directive it does not know, it
# answers EVERY request with
#
#     500  Htaccess evaluation failed
#
# which is exactly what `Header always set ...`, `Options`, `DirectoryIndex`,
# `ErrorDocument`, `<IfModule>` and the compression/caching blocks used to do
# (phpix log: "Unsupported header action", line 61, column 12 = "always").
#
# Everything that is not a rewrite therefore lives in PHP, where it works on
# Herd/nginx, Apache, phpix and `php -S` alike:
#
#    clean URLs / routing      index.php + includes/routes.php
#    dotfiles, db/, tools/     index.php section 2  -> 403, plus phpix's own
#                              "Direct access forbidden" for any path that
#                              starts with a dot. A plain Apache host should
#                              add the <FilesMatch "^\."> deny block back -
#                              see CHANGELOG.md (phpix rejects it).
#    legacy .html -> clean     includes/routes.php ('legacy')
#    .php / index.php strip    index.php
#    404                       index.php -> 404.php
#    security headers + CSP    includes/helpers.php: arail_send_security_headers()
#    https                     Herd/nginx 301 + Wasmer Edge gateway force_https
#    gzip/brotli, caching      the hosting platform
#
# On a plain Apache host you may add compression/caching/HTTPS rules back, but
# check them against phpix first: one unsupported directive takes the whole
# site down.
# ---------------------------------------------------------------------------

RewriteEngine On

# Leave real files and directories alone (assets/, admin/, api/, robots.php,
# sitemap.php, feed.php, 404.php ...).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Everything else is resolved by the front controller.
RewriteRule ^ index.php [QSA,L]
