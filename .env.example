# =============================================================================
#  Arail Pharmaceuticals - environment configuration (TEMPLATE)
# =============================================================================
#
#  This file is the ONLY place the application is configured. Nothing else
#  needs editing: includes/config.php reads every value below with getenv().
#
#  Getting started
#  ---------------
#   1. Copy this file to ".env"        (cp .env.example .env)
#   2. Fill in the real database credentials and store details
#   3. Leave APP_BASE_URL empty until the real domain is live
#
#  Syntax
#  ------
#   * One KEY=value per line. Blank lines and lines starting with "#" are
#     ignored. A value may be quoted ("..." or '...') when it contains spaces,
#     "#" or a trailing space. Nothing is expanded, so "$" stays a literal "$".
#   * A real environment variable of the same name always wins over this file,
#     which is handy for one-off overrides on the command line:
#         APP_DEBUG=1 php install.php
#
#  Security
#  --------
#   * ".env" holds secrets and must never be downloadable. Keep it out of any
#     public directory and make sure the web server denies dotfiles (see the
#     "Protect sensitive files" section of .htaccess).
#   * Never commit ".env" to version control - commit ".env.example" instead.
#   * To keep the secrets outside the web root entirely, park the file elsewhere
#     and point the app at it with the ARAIL_ENV_FILE environment variable (set
#     by the shell, not in this file):  ARAIL_ENV_FILE=/srv/secrets/arail.env
# =============================================================================


# -----------------------------------------------------------------------------
#  Database connection
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me
DB_NAME=arail
# Optional: MySQL connection charset. Almost always utf8mb4.
DB_CHARSET=utf8mb4


# -----------------------------------------------------------------------------
#  Storefront
# -----------------------------------------------------------------------------
APP_NAME=Arail Pharmaceuticals
APP_TAGLINE=Pure Anabolics. Zero compromises.
# Public contact address shown to customers.
APP_EMAIL=lemon@arailpharma.si
# Optional; leave empty to hide phone/address in the footer and contact page.
APP_PHONE=
APP_ADDRESS=

# Money and locale.
APP_CURRENCY=$
APP_CURRENCY_CODE=USD
APP_COUNTRY_CODE=US
# Flat shipping fee added to every order, in the store currency.
APP_SHIPPING_FLAT=0.00
# Minimum order value. Orders below this are refused in the cart, at checkout
# and again server-side in api/order.php (see the minimum-order FAQ).
APP_MIN_ORDER=300.00

# Crypto payment wallets. These public deposit addresses are shown as the
# Bitcoin (BTC) and Ethereum (ETH) options at checkout and on the order
# confirmation. Change them here to adopt a new wallet without editing code.
APP_BTC_ADDRESS=bc1q9take6d97hd9wthp7g2g3kttrly0k4sx84w2c8
APP_ETH_ADDRESS=0x40839B08ac24B45F91f15E7B681467e35EAF156A

# Product image uploads.
APP_UPLOADS_URL=uploads
# Optional absolute path to the uploads directory. Empty = ./uploads next to
# the project root (the default).
APP_UPLOADS_DIR=
APP_MAX_UPLOAD_MB=3

# Canonical domain. This is the live site: arailpharma.si. Every absolute URL
# (canonical tags, Open Graph, sitemaps, product feed) is built from this value.
# Leave it empty only for local development, so URLs follow the request host.
APP_BASE_URL=https://arailpharma.si

# Analytics / search-console verification. Optional.
APP_GA4_ID=
APP_GSC_TOKEN=


# -----------------------------------------------------------------------------
#  Installer defaults (used by install.php only - the live admin account is
#  stored in the database, not here)
# -----------------------------------------------------------------------------
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=Arail@2026


# -----------------------------------------------------------------------------
#  Runtime flags
# -----------------------------------------------------------------------------
# APP_DEBUG=1 shows PHP errors and warnings - enable it while developing,
# keep it 0 on a live site.
APP_DEBUG=0
# The browser installer is disabled unless this is 1. Running
# "php install.php" from the command line always works.
APP_ALLOW_INSTALL=0
